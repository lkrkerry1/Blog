# build output
dist/

# integration cache (esbuild config bundles, plugin-mode font subsets)
.shirones/

# content repository working copy, provenance, and safe cleanup backups
.content-src/
.content-backup/
content.lock.json
Shirone-Content/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

.vercel

package-lock.json
bun.lockb
yarn.lock

# ide
.idea

# generated font subsets
src/assets/fonts/.subset/

# generated local icon collection
src/generated/local-icon-collections.ts
*.iml

# anime snapshot data & downloaded covers
shirones/config/data/anime-snapshots/*.json
public/assets/anime/covers/*
!public/assets/anime/covers/.gitkeep

# Responsive moment thumbnails.
# The installed `shirones` package ships no generator for these, while every
# /images/moments/* image is referenced as <name>-192/-384/-640.webp with no
# existence check and no fallback (src/utils/content-utils.ts). They are
# therefore committed on purpose: a fresh clone — including a Cloudflare Pages
# build — would otherwise render broken moment images. Only the generator's
# cache file stays out of git.
public/assets/moments/thumbnails/.cache.json

# local tooling artifacts
.zcode/
.codex-*.log
research/

# playwright
.playwright-cli/
test-results/
playwright-report/
tests/site/visual.spec.ts-snapshots/

# Lighthouse local reports
artifacts/lighthouse/*
!artifacts/lighthouse/.gitkeep
.lighthouseci/

# generated AI skills plugin packages
artifacts/shirone-ai-*

# shirones integration cache
.shirones/
.shirones-backup/

# local build scratch (esbuild needs a writable temp dir inside the project
# when the sandbox denies it the system temp directory)
.tmp/

# Python bytecode from scripts/make-favicons.py
__pycache__/
*.py[cod]

# ad-hoc build/check logs captured at the repo root
/*.log
